# Non-secret settings. Real credentials belong in the hosting secret manager.
PAYMENT_MODE=demo
SITE_URL=
# Optional persistent database path; default .local/anado.sqlite
# ANADO_DB=/var/lib/anado/anado.sqlite
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# Cloud proxy alternative: full Authorization header in protected secret settings.
# YOOKASSA_AUTHORIZATION=
# Incoming 1C auth needs a real local process secret (24+ chars), not a proxy placeholder.
# ONE_C_TOKEN=
