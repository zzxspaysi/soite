# Non-secret settings. Real credentials belong in the hosting secret manager.
PAYMENT_MODE=demo
# Keep disabled until 1C reservation, fiscalization and live acceptance tests are complete.
LIVE_PAYMENTS_ENABLED=0
SITE_URL=
# Optional persistent database path; default .local/anado.sqlite
# ANADO_DB=/var/lib/anado/anado.sqlite
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# Cloud proxy alternative: full Authorization header in protected secret settings.
# YOOKASSA_AUTHORIZATION=
# Incoming 1C auth needs a real local process secret (24+ chars), not a proxy placeholder.
# ONE_C_TOKEN=

# Optional HTTPS URL of an already published 1C web client (admin shortcut only).
# ONE_C_WEB_URL=

# First admin setup at /admin/setup. With persistent storage, remove both after success.
# Free Render can lose local accounts on redeploy; see docs/ACCOUNTS_AND_1C.md.
# ADMIN_SETUP_EMAIL=
# ADMIN_SETUP_TOKEN=
