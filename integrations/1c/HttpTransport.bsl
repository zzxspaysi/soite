// Общий серверный модуль или модуль внешней обработки, платформа 8.3.27.
// Только HTTP-транспорт: создание документов УТ и регламентное задание
// реализуются под организацию, склад и настройки конкретной базы.
// Не проверено в исполняемой среде 1С. Сначала проверить в копии базы.
Функция ЗапросСайта(Хост, КлючОбмена, Метод, Путь, Данные = Неопределено) Экспорт
    Если Лев(Путь, 21) <> "/api/integrations/1c/" Тогда
        ВызватьИсключение "Недопустимый путь обмена";
    КонецЕсли;
    Если Метод <> "GET" И Метод <> "POST" Тогда
        ВызватьИсключение "Недопустимый метод обмена";
    КонецЕсли;
    Соединение = Новый HTTPСоединение(Хост, 443, , , , 30,
        Новый ЗащищенноеСоединениеOpenSSL);
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Authorization", "Bearer " + КлючОбмена);
    Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Заголовки.Вставить("Accept", "application/json");
    Запрос = Новый HTTPЗапрос(Путь, Заголовки);
    Если Данные <> Неопределено Тогда
        Писатель = Новый ЗаписьJSON;
        Писатель.УстановитьСтроку();
        ЗаписатьJSON(Писатель, Данные);
        Запрос.УстановитьТелоИзСтроки(Писатель.Закрыть(), КодировкаТекста.UTF8,
            ИспользованиеByteOrderMark.НеИспользовать);
    КонецЕсли;
    Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
    Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
        // Не включать ключ или тело с данными покупателя в текст ошибки.
        ВызватьИсключение "Сайт отклонил обмен. HTTP " + Строка(Ответ.КодСостояния);
    КонецЕсли;
    Читатель = Новый ЧтениеJSON;
    Читатель.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
    Результат = ПрочитатьJSON(Читатель);
    Читатель.Закрыть();
    Возврат Результат;
КонецФункции
